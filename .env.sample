# =============================================================================
# MORNING MAILER - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# =============================================================================
# ADMIN PANEL
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ADMIN_PORT=8000

# =============================================================================
# MODEL PROVIDER
# =============================================================================
# Supported: openai, nvidia, openrouter, google
MODEL_PROVIDER=openrouter
MODEL_TEMPERATURE=0.5
MAX_TOKENS=10500

# =============================================================================
# OPENAI
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-nano

# =============================================================================
# NVIDIA
# =============================================================================
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct

# =============================================================================
# OPENROUTER
# =============================================================================
OPEN_ROUTER_API_KEY=sk-or-your-openrouter-api-key-here
OPEN_ROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
OPEN_ROUTER_BASE_URL=https://api.openrouter.ai

# =============================================================================
# GOOGLE GEMINI
# =============================================================================
GOOGLE_API_KEY=AIza-your-google-api-key-here
GOOGLE_MODEL=gemini-2.5-flash

# =============================================================================
# REDIS (Valkey)
# =============================================================================
REDIS_URL=redis://:testpass@valkey:6379/0

# =============================================================================
# USER DETAILS
# =============================================================================
# Used by test email task and as fallback recipient
MY_EMAIL=your-email@gmail.com

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
# Global SMTP credentials — per-user values override these
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# =============================================================================
# SCHEDULER
# =============================================================================
SCHEDULE_TIME=08:00
DAYS_THRESHOLD=2
MAX_EMAIL_RESULTS=20
MAX_THREAD_WORKERS=5
SCHEDULE_CHECK_INTERVAL=5
RETRY_COUNT=2
RETRY_DELAY=60

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# dev  = run multiple times per day (skip last_run check) + DEBUG logs
# prod = run once per day (enforce last_run check) + SUCCESS logs
ENV_MODE=dev

# =============================================================================
# OAUTH CALLBACK URL
# =============================================================================
# Must match the redirect URI configured in Google Cloud Console
# For local dev: http://localhost:8000/oauth/callback
# For remote: https://your-domain.com/oauth/callback
OAUTH_CALLBACK_URL=http://localhost:8000/oauth/callback

# =============================================================================
# WHATSAPP (WAHA)
# =============================================================================
# Essential settings — see compose.yml for WAHA service configuration
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=your-waha-api-key-here
WAHA_SESSION=default

# ── WAHA Dashboard ─────────────────────────────────────────────────────────
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-this-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-this-password
WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True

# ── WAHA Engine ────────────────────────────────────────────────────────────
WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all

# ── WAHA Base URL ──────────────────────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3000

# ── WAHA Logging ───────────────────────────────────────────────────────────
WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=True

# ── WAHA Session ───────────────────────────────────────────────────────────
WHATSAPP_START_SESSION=default
WHATSAPP_RESTART_ALL_SESSIONS=True

# ── WAHA Media Storage ─────────────────────────────────────────────────────
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media
